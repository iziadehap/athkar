<script>
    let count = 12;
    const target = 33;
    const counterDisplay = document.getElementById('counter-value');
    const progressRing = document.getElementById('progress-ring');
    const tapZone = document.getElementById('tap-zone');
    const radius = 130;
    const circumference = 2 * Math.PI * radius;

    function updateProgress() {
      const offset = circumference - (count / target) * circumference;
      progressRing.style.strokeDashoffset = offset;
      counterDisplay.innerText = count;
      
      // Animate the counter text
      counterDisplay.classList.add('scale-110', 'text-tertiary');
      setTimeout(() => {
        counterDisplay.classList.remove('scale-110', 'text-tertiary');
      }, 100);
    }

    tapZone.addEventListener('click', (e) => {
      // Create ripple effect
      const ripple = document.createElement('div');
      ripple.className = 'tap-ripple';
      
      const rect = tapZone.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      ripple.style.width = ripple.style.height = `${size}px`;
      
      const x = e.clientX - rect.left - size / 2;
      const y = e.clientY - rect.top - size / 2;
      ripple.style.left = `${x}px`;
      ripple.style.top = `${y}px`;
      
      tapZone.appendChild(ripple);
      
      ripple.addEventListener('animationend', () => {
        ripple.remove();
      });

      // Increment count
      count++;
      if (count > target) {
        count = 1;
        // Logic for completion can go here (milestone modal)
      }
      updateProgress();

      // Trigger Haptic if supported
      if (window.navigator && window.navigator.vibrate) {
        window.navigator.vibrate(20);
      }
    });

    // Initial render
    updateProgress();
  </script>
