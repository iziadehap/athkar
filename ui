        const dailyPill = document.querySelector('.active-pill');

        const setActive = (target) => {
            // Reset all
            const allPills = [dailyPill, ...pills];
            allPills.forEach(p => {
                p.classList.remove('active-pill');
                p.classList.add('glass-card', 'text-on-surface-variant');
            });
            // Set active
            target.classList.add('active-pill');
            target.classList.remove('glass-card', 'text-on-surface-variant');
        };

        pills.forEach(pill => {
            pill.addEventListener('click', () => setActive(pill));
        });
        dailyPill.addEventListener('click', () => setActive(dailyPill));

        // Interaction for Select buttons
        document.querySelectorAll('button').forEach(btn => {
            btn.addEventListener('mousedown', () => {
                btn.style.transform = 'scale(0.97)';
            });
